# Local development
PORT=5001
FLASK_DEBUG=true
APP_SECRET_KEY=replace-with-a-long-random-value
DISPATCH_API_KEY=replace-with-a-different-long-random-value
BASE_URL=http://127.0.0.1:5001

# Optional locally. Railway should use a reference to Postgres.DATABASE_URL.
# DATABASE_URL=postgresql://user:password@localhost:5432/um_job_alert

# Email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
ALERT_EMAIL_FROM=your-email@gmail.com

# Multi-user Telegram alerts
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_WEBHOOK_SECRET=replace-with-another-long-random-value
TELEGRAM_CONNECT_TTL_MINUTES=30
