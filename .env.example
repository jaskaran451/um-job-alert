# Local development
PORT=5001
APP_SECRET_KEY=replace-with-a-long-random-value
DISPATCH_API_KEY=replace-with-a-different-long-random-value

# Optional locally. Railway must use a reference variable from its Postgres service.
# DATABASE_URL=postgresql://user:password@localhost:5432/um_job_alert

# Public application URL. On Railway, use:
# BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
BASE_URL=http://127.0.0.1:5001

# Email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
ALERT_EMAIL_FROM=your-email@gmail.com
