{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.cron"
  },
  "deploy": {
    "startCommand": "python railway_cron.py",
    "cronSchedule": "*/30 * * * *",
    "restartPolicyType": "NEVER",
    "restartPolicyMaxRetries": 0
  }
}
