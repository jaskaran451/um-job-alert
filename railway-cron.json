{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.cron"
  },
  "deploy": {
    "startCommand": "timeout --signal=TERM 300s python railway_cron.py",
    "cronSchedule": "*/30 * * * *",
    "healthcheckPath": null,
    "healthcheckTimeout": null
  }
}
